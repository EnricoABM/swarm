    {
        "id": "b953421df7a5864a",
        "type": "function",
        "z": "ff7d0f6d9b13f40b",
        "name": "JSON Parser",
        "func": "var estado = msg.payload.windowState;\n\nif (estado == \"opened\") {\n    estado = \"Aberta\";\n} else if (estado == \"closed\") {\n    estado = \"Fechada\";\n}\n\n\n\nvar msg1 = { \n    alarmMode: msg.payload.alarmMode ? \"Ativado\" : \"Desativado\",\n    alarmTrig: msg.payload.alarmTrig ? \"ALERTA!!!\" : \"Normal\"\n };\n\nvar msg2 = { payload: msg.payload.alarmTrig ? \"ALERTA!!!\" : \"Normal\" };\n\nvar msg3 = { payload: msg.payload.lockMode };\n\nvar msg4 = { payload: estado };\n\nvar msg5 = { payload: msg.payload.timeoutState ? \"Expirado\" : \"Normal\" };\nvar msg6 = { \n    timeStarted: msg.payload.timeStarted ? (msg.payload.timeDiff / 1000).toFixed(2) : \"Pausado\",\n    valv: msg.payload.valv ? \"Acionada\" : \"Não Acionada\"   \n};\n\n// Retorna o array de objetos\nreturn [msg1, msg2, msg3, msg4, msg5, msg6];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
