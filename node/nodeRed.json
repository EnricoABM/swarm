        "format": "<div class=\"card\">\n    <div class=\"icon-cicle pump-bg\">\n        <i class=\"fa fa-lock fa-2x pump-icon\" aria-hidden=\"true\"></i>\n    </div>\n    <div class=\"card-info\">\n        <p class=\"label\">Fechadura</p>\n        <p class=\"status\">\n            Status: {{msg.payload ? \"Fechada\" : \"Aberta\"}}\n        </p>\n    </div>\n</div>\n\n<style>\n    \n    .pump-bg {\n        background-color: #d1c4e9;\n    }\n\n    .pump-icon {\n        color: #512da8\n    }\n</style>",
