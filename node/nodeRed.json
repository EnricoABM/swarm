        "name": "Card-Dispositivo CSS",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<style>\n    .nr-dashboard-template p {\n        /* Remover fundo dos templates */\n        background-color: transparent !important;\n    }\n\n    .card {\n        /* Cor de fundo do card */\n        border-radius: 12px;\n        padding: 15px;\n        margin: 10px;\n        \n        background-color: #e6e6e6;\n        display: flex;\n        align-items: center;\n    }\n\n    .icon-cicle {\n        width: 50px;\n        height: 50px;\n        border-radius: 50%;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        margin-right: 15px;\n    }\n\n    .card-info {\n        flex: 1;\n    }\n\n    .label {\n        margin: 0;\n        font-size: 14px;\n        color: #555;\n        background-color: transparent\n    }\n\n    .status {\n        margin: 0;\n        font-weight: bold;\n        font-size: 18px;\n        color: red\n    }\n\n    .nr-dashboard-template {\n        overflow: hidden !important;\n    }\n\n    .card {\n        margin: 0 !important;\n        box-sizing: border-box;\n    }\n</style>",
        "storeOutMessages": true,
